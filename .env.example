# Seed Cloud server
PORT=3000

# Public base URL. Used to build OAuth redirect_uri.
# In production, set this to your HTTPS domain (e.g. https://seedcloud.vercel.app).
# On Vercel this MUST be https://seedcloud.vercel.app (or your custom domain) so
# provider redirect URIs stay stable. Without it the backend falls back to the
# per-deployment VERCEL_URL, which breaks registered redirect URIs.
BASE_URL=http://localhost:3000

# Supabase project (https://supabase.com/dashboard)
# Project Settings > API > Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Project Settings > API > anon / publishable key (safe for frontend)
SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > service_role key (SECRET - server only, never expose to frontend).
# REQUIRED: the backend uses it for every privileged database operation
# (reading/writing provider tokens in connected_accounts, provider registry).
# Without it the server refuses to start.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption secret for provider access tokens stored in connected_accounts.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, tokens are stored in plaintext (dev only) and the server warns.
TOKEN_ENCRYPTION_SECRET=

# pCloud OAuth app
# Create at https://docs.pcloud.com/my_apps/
# Register the EXACT redirect URI below in your pCloud app.
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
# Callback (redirect) URI. Must match the URI registered in the pCloud app
# exactly, including the path and no trailing slash.
# Canonical path: /api/oauth/pcloud/callback
# For local development the default is {BASE_URL}/api/oauth/pcloud/callback,
# which resolves to http://localhost:3000/api/oauth/pcloud/callback.
PCLOUD_REDIRECT_URI=

# Google OAuth app (Seed Cloud's INTERNAL default storage backend).
# Create at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client IDs > Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Authorized redirect URI. Must match the Google Cloud Console entry exactly.
# Canonical callback path: {BASE_URL}/api/storage/google/callback
# Production: https://seedcloud.vercel.app/api/storage/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Vercel production deployment (https://seedcloud.vercel.app)
# ---------------------------------------------------------------------------
# Add ALL of the variables above to the Vercel project's environment variables
# (Settings > Environment Variables) for the Production environment. The server
# refuses to boot without SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY (it exits at cold start).
#
#   BASE_URL=https://seedcloud.vercel.app
#   SUPABASE_URL=https://<your-project>.supabase.co
#   SUPABASE_ANON_KEY=<anon key — safe to expose>
#   SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, NEVER a
#       NEXT_PUBLIC_/VITE_ variable and never exposed to the frontend>
#   TOKEN_ENCRYPTION_SECRET=<random 32 bytes hex — must match the value that
#       encrypted any existing tokens>
#   PCLOUD_CLIENT_ID / PCLOUD_CLIENT_SECRET / PCLOUD_REDIRECT_URI=
#       https://seedcloud.vercel.app/api/oauth/pcloud/callback
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI=
#       https://seedcloud.vercel.app/api/storage/google/callback
#
# REQUIRED database setup in the Supabase SQL editor (the backend cannot apply
# DDL itself):
#   1. db/schema.sql
#   2. db/migration_google_storage.sql
#   3. db/migration_serverless.sql   <-- oauth_state table
#       (required for OAuth connect to work on serverless)