# Seed Cloud server
PORT=3000

# Public base URL. Used to build OAuth redirect_uri.
# In production, set this to your HTTPS domain (e.g. https://cloud.seedcode.dev).
BASE_URL=http://localhost:3000

# Supabase project (https://supabase.com/dashboard)
# Project Settings > API > Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Project Settings > API > anon / publishable key (safe for frontend)
SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > service_role key (SECRET - server only, never expose to frontend).
# REQUIRED: the backend uses it for every privileged database operation
# (reading/writing provider tokens in connected_accounts, provider registry).
# Without it the server refuses to start.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption secret for provider access tokens stored in connected_accounts.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, tokens are stored in plaintext (dev only) and the server warns.
TOKEN_ENCRYPTION_SECRET=

# pCloud OAuth app
# Create at https://docs.pcloud.com/my_apps/
# Register the EXACT redirect URI below in your pCloud app.
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
# Callback (redirect) URI. Must match the URI registered in the pCloud app
# exactly, including the path and no trailing slash.
# Canonical path: /api/oauth/pcloud/callback
# For local development the default is {BASE_URL}/api/oauth/pcloud/callback,
# which resolves to http://localhost:3000/api/oauth/pcloud/callback.
PCLOUD_REDIRECT_URI=

# Google OAuth app (Seed Cloud's INTERNAL default storage backend).
# Create at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client IDs > Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Authorized redirect URI. Must match the Google Cloud Console entry exactly.
# Canonical callback path: {BASE_URL}/api/storage/google/callback
GOOGLE_REDIRECT_URI=